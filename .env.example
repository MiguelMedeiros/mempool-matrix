# Public mempool API endpoint used by the application.
MEMPOOL_API_URL=https://mempool.space/api

# Runtime settings file inside the container. Adjust this to a writable host path when running outside a container.
MEMPOOL_CONFIG_PATH=/data/runtime-config.json

# Leave empty for read-only settings. Generate and set a strong random secret to enable authenticated settings changes.
MEMPOOL_SETTINGS_TOKEN=

# Enable only for trusted development environments; keep disabled in production.
MEMPOOL_ALLOW_UNAUTHENTICATED_SETTINGS=false

# Enable only when the app is behind a trusted reverse proxy that overwrites forwarding headers.
MEMPOOL_TRUST_PROXY=false

# Optional extra denied source hostnames, comma-separated (private IP ranges are always denied).
MEMPOOL_SOURCE_DENY_HOSTS=

# History storage directory inside the container. Adjust this path when running outside a container.
MEMPOOL_HISTORY_DIR=/data/mempool-history

# History sampling interval in milliseconds (matches the current Compose default).
MEMPOOL_HISTORY_INTERVAL_MS=60000

# Number of days to retain history (matches the current Compose default).
MEMPOOL_HISTORY_RETENTION_DAYS=30

# Public host port mapped to the application's container port 3000.
PORT=3033
